rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Contacts collection - users can only access their own contacts
    match /contacts/{contactId} {
      // Allow read if user owns the contact
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Allow create if user is authenticated and sets themselves as owner
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'name', 'phone', 'optedOut', 'addedAt'])
                    && request.resource.data.optedOut is bool
                    && request.resource.data.phone is string
                    && request.resource.data.name is string;
      
      // Allow update if user owns the contact
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Allow delete if user owns the contact
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Messages collection - users can only access their own messages
    match /messages/{messageId} {
      // Allow read if user owns the message
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Allow create if user is authenticated and sets themselves as owner
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'body', 'recipientCount', 'status', 'sentAt'])
                    && request.resource.data.recipientCount is number
                    && request.resource.data.body is string
                    && request.resource.data.status is string;
      
      // Allow update if user owns the message
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
